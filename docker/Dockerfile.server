# syntax=docker/dockerfile:1
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake libssl-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
        -DFORGEFS_BUILD_TESTS=OFF -DFORGEFS_BUILD_BENCHMARKS=OFF \
    && cmake --build build --target forgefs_server -j "$(nproc)"

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /data forgefs

COPY --from=builder /src/build/server/forgefs_server /usr/local/bin/forgefs_server

USER forgefs
WORKDIR /data
EXPOSE 9000
ENTRYPOINT ["forgefs_server"]
